---
type FrameworkKey = 'rcm' | 'teh' | 'prs-ais';

type Props = {
  current?: FrameworkKey;
};

const { current } = Astro.props as Props;

const items: Array<{
  key: FrameworkKey;
  title: string;
  label: string;
  href: string;
  accent: string;
}> = [
  {
    key: 'rcm',
    title: 'RCM',
    label: 'Foundational architecture',
    href: '/model',
    accent: 'from-teal/75 via-tealSoft/50 to-accent/30'
  },
  {
    key: 'teh',
    title: 'TEH',
    label: 'Temporal dynamics',
    href: '/model/expansion-hypothesis',
    accent: 'from-accent/70 via-accentMuted/45 to-tealSoft/35'
  },
  {
    key: 'prs-ais',
    title: 'PRS-AIS',
    label: 'Artificial systems',
    href: '/model/proto-reflexive-states',
    accent: 'from-ink/80 via-teal/60 to-tealSoft/35'
  }
];
---

<section class="scroll-mt-32">
  <div class="cm-panel p-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="cm-section-title">Explore the framework</h2>
        <p class="cm-copy mt-2 text-sm leading-relaxed">
          The three pages form a connected route through architecture, temporal dynamics, and artificial-system interpretation.
        </p>
      </div>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {items.map((item) => {
        const isCurrent = item.key === current;

        return isCurrent ? (
          <article
            aria-current="page"
            class="relative overflow-hidden rounded-lg border border-teal/35 bg-paper/85 p-5 shadow-sm dark:border-accent/35 dark:bg-white/[0.07]"
          >
            <div class={`absolute inset-x-0 top-0 h-1 bg-gradient-to-r ${item.accent} opacity-100`}></div>
            <p class="cm-kicker">
              {item.title}
            </p>
            <p class="mt-3 font-display text-lg font-semibold text-ink dark:text-paper">{item.label}</p>
            <p class="cm-muted mt-4 text-xs font-semibold uppercase tracking-wide">
              Current page
            </p>
          </article>
        ) : (
          <a
            href={item.href}
            class="cm-card group relative overflow-hidden p-5 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            <div class={`absolute inset-x-0 top-0 h-1 bg-gradient-to-r ${item.accent} opacity-70 transition duration-300 group-hover:opacity-100`}></div>
            <p class="cm-kicker">
              {item.title}
            </p>
            <p class="mt-3 font-display text-lg font-semibold text-ink dark:text-paper">{item.label}</p>
            <p class="mt-4 text-xs font-semibold text-ink/60 transition group-hover:text-teal dark:text-paper/70 dark:group-hover:text-accentMuted">
              Open page →
            </p>
          </a>
        );
      })}
    </div>
  </div>
</section>
