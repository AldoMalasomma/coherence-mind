---
import Tag from './Tag.astro';
const { title, href = '#', meta, excerpt, tags = [] } = Astro.props;
---
<article class="cm-card flex flex-col justify-between p-6">
  <div class="space-y-3">
    {meta && <p class="cm-kicker">{meta}</p>}
    <h3 class="font-display text-2xl font-semibold text-ink dark:text-paper">
      <a class="hover:text-teal dark:hover:text-accentMuted" href={href}>{title}</a>
    </h3>
    {excerpt && <p class="cm-copy">{excerpt}</p>}
  </div>
  {tags.length > 0 && (
    <div class="mt-6 flex flex-wrap gap-2">
      {tags.map((tag: string) => (
        <Tag label={tag} />
      ))}
    </div>
  )}
</article>
