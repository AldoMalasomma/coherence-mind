---
import type { TimelineEvent } from '../lib/types';
import RichTextRenderer from './RichTextRenderer';

const { event } = Astro.props as { event: TimelineEvent };

// Robust date label (no crash if date missing/invalid)
const safeDate = (value?: string) => {
  if (!value) return null;
  const d = new Date(value);
  return Number.isFinite(d.getTime()) ? d : null;
};

const d = safeDate(event.date);

const dateLabel =
  event.dateFormatted
    ? event.dateFormatted
    : d
      ? d.toLocaleDateString(undefined, { dateStyle: 'medium' })
      : event.year
        ? String(event.year)
        : '—';
---
<li class="relative pl-10">
  {/* node (ring + dot) */}
  <span class="absolute left-0 top-6 -translate-x-1/2">
    <span class="flex h-6 w-6 items-center justify-center rounded-full border border-ink/15 bg-paper shadow-sm dark:border-white/10 dark:bg-white/[0.055]">
      <span class="h-2.5 w-2.5 rounded-full bg-accent shadow-[0_0_14px_rgba(217,148,43,0.45)]"></span>
    </span>
  </span>

  <article class="cm-card space-y-3 p-5">
    <p class="cm-muted text-xs font-semibold uppercase tracking-[0.24em]">
      {dateLabel}
    </p>

    <h3 class="font-display text-xl font-semibold text-ink dark:text-paper">
      {event.title}
    </h3>

    {event.summary && (
      <p class="cm-copy text-sm leading-relaxed">
        {event.summary}
      </p>
    )}

    {event.body && (
      <div class="prose prose-slate max-w-none dark:prose-invert">
        <RichTextRenderer value={event.body} />
      </div>
    )}
  </article>
</li>
