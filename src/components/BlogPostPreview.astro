---
import type { BlogPostSummary } from '../lib/types';
const { post } = Astro.props as { post: BlogPostSummary };

const normalize = (s = '') =>
  s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();

const tags = (post.tags ?? []).map((t) => String(t));
const searchBlob = normalize(`${post.title ?? ''} ${post.excerpt ?? ''} ${tags.join(' ')}`);
const tagsBlob = normalize(tags.join('|'));
---

<article
  class="blog-card cm-card space-y-3 p-6 hover:-translate-y-0.5"
  data-search={searchBlob}
  data-tags={tagsBlob}
>
  <p class="cm-muted text-xs font-semibold uppercase tracking-[0.24em]">
    {new Date(post.publishedAt).toLocaleDateString(undefined, { dateStyle: 'medium' })}
  </p>

  <h3 class="font-display text-2xl font-semibold text-ink dark:text-paper">
    <a class="rounded-sm transition hover:text-teal focus:outline-none focus:ring-2 focus:ring-accent/40 dark:hover:text-accentMuted" href={`/blog/${post.slug}`}>
      {post.title}
    </a>
  </h3>

  {post.excerpt && (
    <p class="cm-copy text-sm leading-relaxed">{post.excerpt}</p>
  )}

  {post.tags?.length ? (
    <div class="flex flex-wrap gap-2 pt-1">
      {post.tags.map((tag) => (
        <span class="cm-chip">
          {tag}
        </span>
      ))}
    </div>
  ) : null}
</article>
